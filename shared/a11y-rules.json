{
  "version": "1.0.0",
  "wcagVersion": "2.2",
  "rules": [
    { "id": "IMG-01", "check": "<img> missing alt attribute", "category": "Images and Media", "wcag": { "criterion": "1.1.1", "name": "Non-text Content", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["image-alt"], "enabled": true },
    { "id": "IMG-02", "check": "Alt text is a filename", "category": "Images and Media", "wcag": { "criterion": "1.1.1", "name": "Non-text Content", "level": "A" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "IMG-03", "check": "Alt text is generic (\"image\", \"photo\", \"icon\")", "category": "Images and Media", "wcag": { "criterion": "1.1.1", "name": "Non-text Content", "level": "A" }, "type": "Auto", "severity": "Moderate", "enabled": true },
    { "id": "IMG-04", "check": "Alt text starts with \"image of\" / \"picture of\"", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Minor", "axeRules": ["image-redundant-alt"], "enabled": true },
    { "id": "IMG-05", "check": "<svg role=\"img\"> with no <title>, aria-label, or aria-labelledby", "category": "Images and Media", "wcag": { "criterion": "1.1.1", "name": "Non-text Content", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["svg-img-alt", "role-img-alt"], "enabled": true },
    { "id": "IMG-06", "check": "<input type=\"image\">, <area>, or <object> without text alternative", "category": "Images and Media", "wcag": { "criterion": "1.1.1", "name": "Non-text Content", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["input-image-alt", "area-alt", "object-alt", "server-side-image-map"], "enabled": true },
    { "id": "IMG-08", "check": "Inline <svg> with no role, no accessible name, and no aria-hidden (may be decorative)", "category": "Images and Media", "wcag": { "criterion": "1.1.1", "name": "Non-text Content", "level": "A" }, "type": "Semi", "severity": "Moderate", "enabled": true },
    { "id": "MED-01", "check": "<video> without a captions <track>", "category": "Images and Media", "wcag": { "criterion": "1.2.2", "name": "Captions (Prerecorded)", "level": "A" }, "type": "Semi", "severity": "Critical", "axeRules": ["video-caption", "audio-caption"], "enabled": true },
    { "id": "MED-02", "check": "Media autoplays with sound for more than 3 seconds", "category": "Images and Media", "wcag": { "criterion": "1.4.2", "name": "Audio Control", "level": "A" }, "type": "Semi", "severity": "Serious", "axeRules": ["no-autoplay-audio"], "enabled": true },

    { "id": "CLR-01", "check": "Normal text contrast below 4.5:1", "category": "Color and Contrast", "wcag": { "criterion": "1.4.3", "name": "Contrast (Minimum)", "level": "AA" }, "type": "Auto", "severity": "Serious", "axeRules": ["color-contrast"], "enabled": true },
    { "id": "CLR-02", "check": "Large text (24px, or 18.66px bold) contrast below 3:1", "category": "Color and Contrast", "wcag": { "criterion": "1.4.3", "name": "Contrast (Minimum)", "level": "AA" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "CLR-03", "check": "Text over image or gradient (contrast undeterminable)", "category": "Color and Contrast", "wcag": { "criterion": "1.4.3", "name": "Contrast (Minimum)", "level": "AA" }, "type": "Semi", "severity": "Moderate", "enabled": true },
    { "id": "CLR-04", "check": "UI component borders/icons below 3:1", "category": "Color and Contrast", "wcag": { "criterion": "1.4.11", "name": "Non-text Contrast", "level": "AA" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "CLR-05", "check": "Focus indicator below 3:1 against adjacent colors", "category": "Color and Contrast", "wcag": { "criterion": "1.4.11", "name": "Non-text Contrast", "level": "AA" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "CLR-06", "check": "Links distinguished from text by color only", "category": "Color and Contrast", "wcag": { "criterion": "1.4.1", "name": "Use of Color", "level": "A" }, "type": "Semi", "severity": "Serious", "axeRules": ["link-in-text-block"], "enabled": true },
    { "id": "CLR-08", "check": "Text contrast below 7:1 (enhanced)", "category": "Best Practice", "wcag": { "criterion": "1.4.6", "name": "Contrast (Enhanced)", "level": "AAA" }, "type": "Auto", "severity": "Minor", "axeRules": ["color-contrast-enhanced"], "enabled": false },

    { "id": "FRM-01", "check": "Input has no accessible label", "category": "Forms", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["label", "select-name", "aria-input-field-name", "aria-toggle-field-name"], "enabled": true },
    { "id": "FRM-02", "check": "Placeholder or title is the only label", "category": "Forms", "wcag": { "criterion": "3.3.2", "name": "Labels or Instructions", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["label-title-only"], "enabled": true },
    { "id": "FRM-03", "check": "Radio/checkbox group with no group label (fieldset+legend or role=group + aria-labelledby)", "category": "Forms", "wcag": { "criterion": "1.3.1", "name": "Info and Relationships", "level": "A" }, "type": "Auto", "severity": "Moderate", "enabled": true },
    { "id": "FRM-04", "check": "Required field not indicated programmatically", "category": "Forms", "wcag": { "criterion": "3.3.2", "name": "Labels or Instructions", "level": "A" }, "type": "Auto", "severity": "Moderate", "enabled": true },
    { "id": "FRM-05", "check": "Error message not linked via aria-describedby", "category": "Forms", "wcag": { "criterion": "3.3.1", "name": "Error Identification", "level": "A" }, "type": "Semi", "severity": "Serious", "enabled": true },
    { "id": "FRM-06", "check": "Invalid field missing aria-invalid=\"true\"", "category": "Forms", "wcag": { "criterion": "3.3.1", "name": "Error Identification", "level": "A" }, "type": "Semi", "severity": "Moderate", "enabled": true },
    { "id": "FRM-07", "check": "Personal data fields missing or invalid autocomplete", "category": "Forms", "wcag": { "criterion": "1.3.5", "name": "Identify Input Purpose", "level": "AA" }, "type": "Auto", "severity": "Moderate", "axeRules": ["autocomplete-valid"], "enabled": true },
    { "id": "FRM-08", "check": "Visible label text not included in accessible name", "category": "Forms", "wcag": { "criterion": "2.5.3", "name": "Label in Name", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["label-content-name-mismatch"], "enabled": true },
    { "id": "FRM-10", "check": "Form field has multiple labels", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Minor", "axeRules": ["form-field-multiple-labels"], "enabled": true },

    { "id": "KBD-01", "check": "Clickable element not keyboard focusable", "category": "Keyboard and Focus", "wcag": { "criterion": "2.1.1", "name": "Keyboard", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["scrollable-region-focusable"], "enabled": true },
    { "id": "KBD-02", "check": "Keyboard trap detected", "category": "Keyboard and Focus", "wcag": { "criterion": "2.1.2", "name": "No Keyboard Trap", "level": "A" }, "type": "Auto", "severity": "Critical", "enabled": true },
    { "id": "KBD-03", "check": "Positive tabindex value used", "category": "Best Practice", "wcag": { "criterion": "2.4.3", "name": "Focus Order", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["tabindex"], "enabled": true },
    { "id": "KBD-04", "check": "Illogical focus order (visual vs DOM order)", "category": "Keyboard and Focus", "wcag": { "criterion": "2.4.3", "name": "Focus Order", "level": "A" }, "type": "Semi", "severity": "Moderate", "axeRules": ["focus-order-semantics"], "enabled": true },
    { "id": "KBD-05", "check": "No visible focus indicator", "category": "Keyboard and Focus", "wcag": { "criterion": "2.4.7", "name": "Focus Visible", "level": "AA" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "KBD-06", "check": "Focused element obscured by sticky content", "category": "Keyboard and Focus", "wcag": { "criterion": "2.4.11", "name": "Focus Not Obscured (Minimum)", "level": "AA" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "KBD-07", "check": "No bypass mechanism (no skip link, landmarks, or headings)", "category": "Keyboard and Focus", "wcag": { "criterion": "2.4.1", "name": "Bypass Blocks", "level": "A" }, "type": "Auto", "severity": "Moderate", "axeRules": ["bypass", "skip-link"], "enabled": true },
    { "id": "KBD-08", "check": "Modal does not move focus in / return focus on close", "category": "Keyboard and Focus", "wcag": { "criterion": "2.4.3", "name": "Focus Order", "level": "A" }, "type": "Semi", "severity": "Serious", "enabled": true },
    { "id": "KBD-10", "check": "Interactive controls nested inside each other", "category": "Keyboard and Focus", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["nested-interactive"], "enabled": true },
    { "id": "KBD-11", "check": "Duplicate accesskey values", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Minor", "axeRules": ["accesskeys"], "enabled": true },

    { "id": "STR-01", "check": "Missing or empty <title>", "category": "Page Structure and Semantics", "wcag": { "criterion": "2.4.2", "name": "Page Titled", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["document-title"], "enabled": true },
    { "id": "STR-02", "check": "<html> missing valid lang", "category": "Page Structure and Semantics", "wcag": { "criterion": "3.1.1", "name": "Language of Page", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["html-has-lang", "html-lang-valid", "html-xml-lang-mismatch"], "enabled": true },
    { "id": "STR-03", "check": "No <h1> on the page", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Moderate", "axeRules": ["page-has-heading-one"], "enabled": true },
    { "id": "STR-04", "check": "Heading levels skipped", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Moderate", "axeRules": ["heading-order"], "enabled": true },
    { "id": "STR-05", "check": "Missing or duplicate <main> landmark", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Moderate", "axeRules": ["landmark-one-main", "landmark-no-duplicate-main"], "enabled": true },
    { "id": "STR-06", "check": "Content outside landmarks or landmark misuse", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Minor", "axeRules": ["region", "landmark-no-duplicate-banner", "landmark-no-duplicate-contentinfo", "landmark-banner-is-top-level", "landmark-contentinfo-is-top-level", "landmark-main-is-top-level", "landmark-complementary-is-top-level", "landmark-unique"], "enabled": true },
    { "id": "STR-07", "check": "Data table without proper header association (<th>/scope/headers)", "category": "Page Structure and Semantics", "wcag": { "criterion": "1.3.1", "name": "Info and Relationships", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["td-headers-attr", "th-has-data-cells", "table-duplicate-name", "scope-attr-valid", "table-fake-caption"], "enabled": true },
    { "id": "STR-08", "check": "Duplicate id referenced by ARIA or <label for>", "category": "Page Structure and Semantics", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["duplicate-id-aria"], "enabled": true },
    { "id": "STR-09", "check": "<iframe> missing or duplicate title", "category": "Page Structure and Semantics", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["frame-title", "frame-title-unique"], "enabled": true },
    { "id": "STR-11", "check": "Invalid lang attribute on an element", "category": "Page Structure and Semantics", "wcag": { "criterion": "3.1.2", "name": "Language of Parts", "level": "AA" }, "type": "Auto", "severity": "Moderate", "axeRules": ["valid-lang"], "enabled": true },
    { "id": "STR-12", "check": "Empty heading or paragraph styled as heading", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Auto", "severity": "Minor", "axeRules": ["empty-heading", "p-as-heading"], "enabled": true },
    { "id": "STR-13", "check": "Frame could not be scanned", "category": "Best Practice", "wcag": { "criterion": "", "name": "Best practice", "level": "BP" }, "type": "Semi", "severity": "Minor", "axeRules": ["frame-tested"], "enabled": true },
    { "id": "STR-14", "check": "List structure invalid (<li> outside <ul>/<ol>, invalid <dl>)", "category": "Page Structure and Semantics", "wcag": { "criterion": "1.3.1", "name": "Info and Relationships", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["list", "listitem", "definition-list", "dlitem"], "enabled": true },

    { "id": "ARIA-01", "check": "Invalid, deprecated, or disallowed role", "category": "ARIA", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["aria-roles", "aria-allowed-role", "aria-deprecated-role", "presentation-role-conflict", "aria-text"], "enabled": true },
    { "id": "ARIA-02", "check": "Required ARIA attribute missing or attribute not allowed", "category": "ARIA", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["aria-required-attr", "aria-valid-attr", "aria-allowed-attr", "aria-prohibited-attr", "aria-conditional-attr", "aria-braille-equivalent"], "enabled": true },
    { "id": "ARIA-03", "check": "ARIA attribute value invalid or references missing id", "category": "ARIA", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["aria-valid-attr-value"], "enabled": true },
    { "id": "ARIA-04", "check": "aria-hidden=\"true\" on focusable element or <body>", "category": "ARIA", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["aria-hidden-focus", "aria-hidden-body"], "enabled": true },
    { "id": "ARIA-05", "check": "Required child/parent role missing", "category": "ARIA", "wcag": { "criterion": "1.3.1", "name": "Info and Relationships", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["aria-required-children", "aria-required-parent"], "enabled": true },
    { "id": "ARIA-07", "check": "ARIA widget (dialog, meter, progressbar, tooltip, treeitem) without accessible name", "category": "ARIA", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["aria-dialog-name", "aria-meter-name", "aria-progressbar-name", "aria-tooltip-name", "aria-treeitem-name"], "enabled": true },

    { "id": "LNK-01", "check": "Link with no accessible name", "category": "Links, Buttons, and Targets", "wcag": { "criterion": "2.4.4", "name": "Link Purpose (In Context)", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["link-name"], "enabled": true },
    { "id": "LNK-02", "check": "Button or command with no accessible name", "category": "Links, Buttons, and Targets", "wcag": { "criterion": "4.1.2", "name": "Name, Role, Value", "level": "A" }, "type": "Auto", "severity": "Critical", "axeRules": ["button-name", "input-button-name", "aria-command-name", "summary-name"], "enabled": true },
    { "id": "LNK-03", "check": "Vague link text (\"click here\", \"read more\")", "category": "Best Practice", "wcag": { "criterion": "2.4.4", "name": "Link Purpose (In Context)", "level": "A" }, "type": "Auto", "severity": "Moderate", "enabled": true },
    { "id": "LNK-04", "check": "Same link text, different destinations", "category": "Best Practice", "wcag": { "criterion": "2.4.4", "name": "Link Purpose (In Context)", "level": "A" }, "type": "Auto", "severity": "Moderate", "axeRules": ["identical-links-same-purpose"], "enabled": true },
    { "id": "LNK-05", "check": "Link opens new window without warning", "category": "Best Practice", "wcag": { "criterion": "3.2.5", "name": "Change on Request", "level": "AAA" }, "type": "Auto", "severity": "Minor", "enabled": true },
    { "id": "TGT-01", "check": "Target smaller than 24x24 CSS px without sufficient spacing", "category": "Links, Buttons, and Targets", "wcag": { "criterion": "2.5.8", "name": "Target Size (Minimum)", "level": "AA" }, "type": "Auto", "severity": "Moderate", "axeRules": ["target-size"], "enabled": true },

    { "id": "ZM-01", "check": "Viewport meta disables zoom or caps maximum-scale", "category": "Responsiveness and Zoom", "wcag": { "criterion": "1.4.4", "name": "Resize Text", "level": "AA" }, "type": "Auto", "severity": "Critical", "axeRules": ["meta-viewport", "meta-viewport-large"], "enabled": true },
    { "id": "ZM-02", "check": "Horizontal scroll at 320 CSS px width", "category": "Responsiveness and Zoom", "wcag": { "criterion": "1.4.10", "name": "Reflow", "level": "AA" }, "type": "Auto", "severity": "Serious", "enabled": true },
    { "id": "ZM-03", "check": "Content clipped or spacing locked with increased text spacing", "category": "Responsiveness and Zoom", "wcag": { "criterion": "1.4.12", "name": "Text Spacing", "level": "AA" }, "type": "Auto", "severity": "Moderate", "axeRules": ["avoid-inline-spacing"], "enabled": true },

    { "id": "OTH-01", "check": "Timed refresh or redirect via <meta http-equiv=\"refresh\">", "category": "Other", "wcag": { "criterion": "2.2.1", "name": "Timing Adjustable", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["meta-refresh", "meta-refresh-no-exceptions"], "enabled": true },
    { "id": "OTH-02", "check": "Blinking or scrolling content (<blink>, <marquee>)", "category": "Other", "wcag": { "criterion": "2.2.2", "name": "Pause, Stop, Hide", "level": "A" }, "type": "Auto", "severity": "Serious", "axeRules": ["blink", "marquee"], "enabled": true },
    { "id": "OTH-03", "check": "Orientation locked via CSS", "category": "Other", "wcag": { "criterion": "1.3.4", "name": "Orientation", "level": "AA" }, "type": "Auto", "severity": "Serious", "axeRules": ["css-orientation-lock"], "enabled": true }
  ]
}
